<Application x:Class="ThesGamer.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#FF0E1116"/>
        <SolidColorBrush x:Key="Panel" Color="#FF161A21"/>
        <SolidColorBrush x:Key="Accent" Color="#FF3ECFAD"/>
        <SolidColorBrush x:Key="Text" Color="#FFF5F7FA"/>
        <SolidColorBrush x:Key="Muted" Color="#FF8B95A5"/>
        <SolidColorBrush x:Key="Line" Color="#FF2A313D"/>
    </Application.Resources>
</Application>
