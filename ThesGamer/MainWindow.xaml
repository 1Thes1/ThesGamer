<Window x:Class="ThesGamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thes Gamer"
        Height="820" Width="1180"
        MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}">

    <Window.Resources>
        <Geometry x:Key="IconOverview">M3,12 L9,6 L13,10 L21,2 M14,2 L21,2 L21,9</Geometry>
        <Geometry x:Key="IconMemory">M4,7 H20 V17 H4 Z M7,10 V14 M10,10 V14 M14,10 V14 M17,10 V14</Geometry>
        <Geometry x:Key="IconCleanup">M6,7 H18 M8,7 V18 H16 V7 M10,4 H14</Geometry>
        <Geometry x:Key="IconDrivers">M12,3 L19,7 V13 L12,17 L5,13 V7 Z</Geometry>
        <Geometry x:Key="IconGames">M5,10 H19 C20,10 21,11 21,12 V15 C21,16 20,17 19,17 H5 C4,17 3,16 3,15 V12 C3,11 4,10 5,10 Z M8,13 H8.01 M16,12 L17,13 L16,14 M12,8 V10</Geometry>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icon rail like Thes VPN -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgRail}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,16">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF3ECFAD" Offset="0"/>
                                <GradientStop Color="#FF2B8CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="TG" FontWeight="Bold" FontSize="13" Foreground="#FF061018"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <RadioButton x:Name="NavOverview" Style="{StaticResource IconNav}" IsChecked="True" Checked="Nav_Checked" ToolTip="Обзор">
                        <Path Data="M4,14 L10,8 L14,12 L20,6" Stroke="{StaticResource BrushMuted}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavMemory" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Память">
                        <Path Data="M5,8 H19 V16 H5 Z M8,10.5 V13.5 M11,10.5 V13.5 M14,10.5 V13.5 M17,10.5 V13.5"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.6" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Чистка">
                        <Path Data="M7,8 H17 M9,8 V17 H15 V8 M10,6 H14"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavDrivers" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Драйверы">
                        <Path Data="M12,4 L18,7.5 V14 L12,17.5 L6,14 V7.5 Z"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavGames" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Игры">
                        <Path Data="M6,11 H18 C19.1,11 20,11.9 20,13 V15.5 C20,16.6 19.1,17.5 18,17.5 H6 C4.9,17.5 4,16.6 4,15.5 V13 C4,11.9 4.9,11 6,11 Z M9,14.2 H9.01 M15.5,13.2 L16.5,14.2 L15.5,15.2"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.5" Fill="Transparent" Width="20" Height="16" Stretch="Uniform"/>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushAccent}" Margin="0,0,0,10"/>
                    <TextBlock Text="Thes" FontSize="10" Foreground="{StaticResource BrushMuted}"
                               HorizontalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonUp="GitHubLink_OnClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content with grid + glow like VPN -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" Opacity="0.18">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 H28 M0,0 V28">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#FF3A4555" Thickness="1"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>

            <!-- Soft cyan corner glows -->
            <Ellipse Width="420" Height="420" Margin="-160,-180,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     IsHitTestVisible="False" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF3ECFAD" Offset="0"/>
                        <GradientStop Color="#003ECFAD" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="380" Height="380" Margin="0,0,-140,-160" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     IsHitTestVisible="False" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF2B8CFF" Offset="0"/>
                        <GradientStop Color="#002B8CFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="28,22,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Shared header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="HeaderUser" Style="{StaticResource PageSub}" Text="by Thes · github.com/1Thes1"
                                   Cursor="Hand" MouseLeftButtonUp="GitHubLink_OnClick"/>
                        <TextBlock x:Name="HeaderTitle" Style="{StaticResource PageTitle}" Text="Обзор"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU" Foreground="{StaticResource BrushMuted}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="CpuPill" Text="—" FontWeight="SemiBold" Foreground="{StaticResource BrushWarn}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM" Foreground="{StaticResource BrushMuted}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="RamPill" Text="—" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatPill}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DISK" Foreground="{StaticResource BrushMuted}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DiskPill" Text="—" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Content="Обновить" Click="RefreshOverview_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="Safe Boost" Click="ApplyBoost_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Pages -->
                <Grid Grid.Row="1">
                    <!-- OVERVIEW -->
                    <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Нагрузка системы" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ProcessCountInfo" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,6,0,12"/>
                                        <ProgressBar x:Name="RamBar" Maximum="100" Height="8"/>
                                        <TextBlock x:Name="RamValue" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BrushBgPanelHi}" CornerRadius="999"
                                            Padding="14,8" VerticalAlignment="Top" Margin="16,0,0,0"
                                            BorderBrush="{StaticResource BrushLine}" BorderThickness="1">
                                        <TextBlock x:Name="DefenderValue" Text="Defender —" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="HostInfo" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UptimeInfo" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="DefenderUpdated" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="Скан Defender" Click="DefenderScan_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                                        <TextBlock x:Name="CpuValue" FontSize="28" FontWeight="Bold" Margin="0,6,0,10"/>
                                        <ProgressBar x:Name="CpuBar" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="RAM" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                                        <TextBlock x:Name="MemoryStatus" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10" TextWrapping="Wrap"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Освободить RAM" HorizontalAlignment="Left" Margin="0" Click="FreeRam_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Диск C:" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                                        <TextBlock x:Name="DiskValue" FontSize="28" FontWeight="Bold" Margin="0,6,0,10"/>
                                        <ProgressBar x:Name="DiskBar" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Padding="16" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Топ процессов" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="ProcessGrid" MaxHeight="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                                            <DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="МБ" Binding="{Binding MemoryMb, StringFormat=N0}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- MEMORY -->
                    <ScrollViewer x:Name="PageMemory" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Очистка RAM" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Аккуратно подрезает working set. Standby — только от администратора."
                                               Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Освободить RAM" Click="FreeRam_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Обновить" Click="RefreshMemory_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MemoryLog" Foreground="{StaticResource BrushMuted}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <CheckBox x:Name="AutoRamCheck" Content="Автоочистка при высокой загрузке RAM"
                                              Checked="AutoRam_Changed" Unchecked="AutoRam_Changed"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="AutoRamSlider" Minimum="70" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="AutoRamSlider_Changed"/>
                                        <TextBlock x:Name="AutoRamThresholdLabel" Grid.Column="1" VerticalAlignment="Center"
                                                   Margin="12,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Text="85%"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- CLEANUP -->
                    <ScrollViewer x:Name="PageCleanup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Чистка Temp" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Удаляет временные файлы. Заблокированные объекты пропускаются."
                                           Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Очистить Temp" Click="CleanTemp_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Очистка диска Windows" Click="DiskCleanup_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="CleanupLog" Foreground="{StaticResource BrushMuted}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- DRIVERS -->
                    <Grid x:Name="PageDrivers" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
                            <DataGrid x:Name="DriverGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" Width="2*"/>
                                    <DataGridTextColumn Header="Версия" Binding="{Binding DriverVersion}" Width="*"/>
                                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DriverDate}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Сканировать" Click="ScanDrivers_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Windows Update" Click="WindowsUpdate_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Диспетчер устройств" Click="DeviceManager_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- GAMES -->
                    <Grid x:Name="PageGames" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PresetHint" FontSize="18" FontWeight="SemiBold" Text="Black Desert"/>
                                    <TextBlock Text="Game Mode · план питания · приоритет процесса · точка восстановления"
                                               Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatPill}" VerticalAlignment="Top" Margin="0">
                                    <TextBlock Text="Boost ready" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,10,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Профиль"/>
                                    <ComboBox x:Name="GameProfileBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <ComboBoxItem Content="FPS"/>
                                        <ComboBoxItem Content="Quality"/>
                                        <ComboBoxItem Content="Battery"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Процесс игры"/>
                                    <TextBox x:Name="GameProcessBox" Margin="0,0,0,8"/>
                                    <TextBlock Text="Без .exe — BlackDesert64, cs2, dota2…"
                                               Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,0,0,16"/>
                                    <CheckBox x:Name="RestorePointCheck" Content="Точка восстановления перед бустом" IsChecked="True"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Применить буст" Click="ApplyBoost_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Приоритет" Click="FocusGame_Click"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}" Content="Защита системы" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenRestore_Click"/>
                                    <Border Background="{StaticResource BrushBgDeep}" CornerRadius="12" Padding="12" Margin="0,16,0,0"
                                            BorderBrush="{StaticResource BrushLine}" BorderThickness="1">
                                        <TextBlock x:Name="GameLog" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Text="Готово к бусту."/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Быстрый выбор"/>
                                    <ListBox x:Name="PresetBox" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="PresetBox_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="{StaticResource BrushBgDeep}"
                                                                    BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                                                    CornerRadius="12" Padding="14,12" Cursor="Hand">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentDim}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <WrapPanel Grid.Row="2">
                            <RadioButton Style="{StaticResource Chip}" Content="Black Desert" IsChecked="True" Tag="Black Desert" Checked="PresetChip_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="CS2" Tag="CS2" Checked="PresetChip_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Valorant" Tag="Valorant" Checked="PresetChip_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Dota 2" Tag="Dota 2" Checked="PresetChip_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Fortnite" Tag="Fortnite" Checked="PresetChip_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="GTA V" Tag="GTA V" Checked="PresetChip_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Manual" Tag="Custom / Manual" Checked="PresetChip_Checked"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
