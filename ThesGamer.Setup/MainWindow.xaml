<Window x:Class="ThesGamer.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thes Gamer Setup"
        Height="460" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="THES GAMER" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="Installer · Установщик" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            <TextBlock x:Name="PathText" Foreground="{StaticResource Text}" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Installs Thes Gamer and creates shortcuts. / Установит Thes Gamer и создаст ярлыки."/>
            <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Value="0"
                         Foreground="{StaticResource Accent}" Background="#FF242B36" BorderThickness="0"/>
            <CheckBox x:Name="DesktopShortcut" Content="Desktop shortcut / Ярлык на рабочий стол" IsChecked="True"
                      Foreground="{StaticResource Text}" Margin="0,16,0,8"/>
            <CheckBox x:Name="StartMenuShortcut" Content="Start Menu shortcut / Ярлык в меню Пуск" IsChecked="True"
                      Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
            <CheckBox x:Name="LaunchAfter" Content="Launch after install / Запустить после установки" IsChecked="True"
                      Foreground="{StaticResource Text}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Uninstall / Удалить" Padding="16,10" Margin="0,0,10,0" Click="Uninstall_Click"
                    Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"/>
            <Button Content="Install / Установить" Padding="18,10" Click="Install_Click"
                    Background="{StaticResource Accent}" Foreground="#FF061018" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
