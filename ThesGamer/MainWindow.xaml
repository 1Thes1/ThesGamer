<Window x:Class="ThesGamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thes Gamer"
        Height="840" Width="1200"
        MinHeight="720" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rail -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgRail}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,14">
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF3ECFAD" Offset="0"/>
                                <GradientStop Color="#FF2B8CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="TG" FontWeight="Bold" FontSize="12" Foreground="#FF061018"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <RadioButton x:Name="NavOverview" Style="{StaticResource IconNav}" IsChecked="True" Checked="Nav_Checked" ToolTip="Обзор">
                        <Path x:Name="IconOverviewPath" Data="M4,14 L10,8 L14,12 L20,6" Stroke="{StaticResource BrushMuted}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavMemory" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Память">
                        <Path x:Name="IconMemoryPath" Data="M5,8 H19 V16 H5 Z M8,10.5 V13.5 M11,10.5 V13.5 M14,10.5 V13.5 M17,10.5 V13.5"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.6" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Чистка">
                        <Path x:Name="IconCleanupPath" Data="M7,8 H17 M9,8 V17 H15 V8 M10,6 H14"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavDrivers" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Драйверы">
                        <Path x:Name="IconDriversPath" Data="M12,4 L18,7.5 V14 L12,17.5 L6,14 V7.5 Z"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                    </RadioButton>
                    <RadioButton x:Name="NavGames" Style="{StaticResource IconNav}" Checked="Nav_Checked" ToolTip="Игры">
                        <Path x:Name="IconGamesPath" Data="M6,11 H18 C19.1,11 20,11.9 20,13 V15.5 C20,16.6 19.1,17.5 18,17.5 H6 C4.9,17.5 4,16.6 4,15.5 V13 C4,11.9 4.9,11 6,11 Z"
                              Stroke="{StaticResource BrushMuted}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="14" Stretch="Uniform"/>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource BrushAccent}" Margin="0,0,0,8"/>
                    <TextBlock Text="Thes" FontSize="10" Foreground="{StaticResource BrushMuted}"
                               HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="GitHubLink_OnClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" ClipToBounds="True">
            <Rectangle Fill="{StaticResource BrushBgDeep}"/>
            <Rectangle Opacity="0.12" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M0,0 H32 M0,0 V32">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#FF4A5568" Thickness="1"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Width="480" Height="480" Margin="-200,-220,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     IsHitTestVisible="False" Opacity="0.14">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF3ECFAD" Offset="0"/>
                        <GradientStop Color="#003ECFAD" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="26,18,26,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="by Thes · github.com/1Thes1" Style="{StaticResource PageSub}"
                                   Cursor="Hand" MouseLeftButtonUp="GitHubLink_OnClick"/>
                        <TextBlock x:Name="HeaderTitle" Style="{StaticResource PageTitle}" Text="Обзор"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- CPU ring -->
                        <Border Background="#99141920" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                CornerRadius="14" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40" Margin="0,0,8,0">
                                    <Ellipse Stroke="#FF2A3340" StrokeThickness="3.2"/>
                                    <Path x:Name="CpuRing" Stroke="{StaticResource BrushWarn}" StrokeThickness="3.2"/>
                                    <TextBlock x:Name="CpuPill" Text="—" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource BrushWarn}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="CPU" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM ring -->
                        <Border Background="#99141920" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                CornerRadius="14" Padding="10,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40" Margin="0,0,8,0">
                                    <Ellipse Stroke="#FF2A3340" StrokeThickness="3.2"/>
                                    <Path x:Name="RamRing" Stroke="{StaticResource BrushAccent}" StrokeThickness="3.2"/>
                                    <TextBlock x:Name="RamPill" Text="—" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="RAM" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- DISK ring -->
                        <Border Background="#99141920" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                CornerRadius="14" Padding="10,8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40" Margin="0,0,8,0">
                                    <Ellipse Stroke="#FF2A3340" StrokeThickness="3.2"/>
                                    <Path x:Name="DiskRing" Stroke="#FFB8C0CC" StrokeThickness="3.2"/>
                                    <TextBlock x:Name="DiskPill" Text="—" FontSize="11" FontWeight="Bold"
                                               Foreground="#FFE8EDF4"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="DISK" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource GhostButton}" Content="Обновить" Click="RefreshOverview_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="Safe Boost" Click="ApplyBoost_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Pages -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Нагрузка системы" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="ProcessCountInfo" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,8,0,12"/>
                                        <ProgressBar x:Name="RamBar" Maximum="100" Height="8"/>
                                        <TextBlock x:Name="RamValue" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="999" Padding="12,7" VerticalAlignment="Top" Margin="16,0,0,0"
                                            Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1">
                                        <TextBlock x:Name="DefenderValue" Text="Defender" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="HostInfo" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}"/>
                                        <TextBlock x:Name="UptimeInfo" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="DefenderUpdated" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Скан Defender"
                                            VerticalAlignment="Center" Click="DefenderScan_Click"/>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Foreground="{StaticResource BrushMuted}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CpuValue" FontSize="26" FontWeight="Bold" Margin="0,8,0,10"
                                                   Foreground="{StaticResource BrushWarn}"/>
                                        <ProgressBar x:Name="CpuBar" Maximum="100" Foreground="{StaticResource BrushWarn}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="RAM" Foreground="{StaticResource BrushMuted}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MemoryStatus" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushAccent}"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Освободить RAM" HorizontalAlignment="Left" Margin="0" Click="FreeRam_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Диск C:" Foreground="{StaticResource BrushMuted}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DiskValue" FontSize="26" FontWeight="Bold" Margin="0,8,0,10"
                                                   Foreground="{StaticResource BrushText}"/>
                                        <ProgressBar x:Name="DiskBar" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Топ процессов" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="ProcessGrid" MaxHeight="240">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="МБ" Binding="{Binding MemoryMb, StringFormat=N0}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageMemory" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Очистка RAM" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Аккуратно подрезает working set. Standby — только от администратора."
                                               Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Освободить RAM" Click="FreeRam_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Обновить" Click="RefreshMemory_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MemoryLog" Foreground="{StaticResource BrushMuted}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <CheckBox x:Name="AutoRamCheck" Content="Автоочистка при высокой загрузке RAM"
                                              Checked="AutoRam_Changed" Unchecked="AutoRam_Changed"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="AutoRamSlider" Minimum="70" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="AutoRamSlider_Changed"/>
                                        <TextBlock x:Name="AutoRamThresholdLabel" Grid.Column="1" VerticalAlignment="Center"
                                                   Margin="12,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Text="85%"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageCleanup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" Margin="0" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Чистка Temp" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Удаляет временные файлы. Заблокированные объекты пропускаются."
                                           Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Очистить Temp" Click="CleanTemp_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Очистка диска Windows" Click="DiskCleanup_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="CleanupLog" Foreground="{StaticResource BrushMuted}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Grid x:Name="PageDrivers" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
                            <DataGrid x:Name="DriverGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Версия" Binding="{Binding DriverVersion}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DriverDate}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Сканировать" Click="ScanDrivers_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Windows Update" Click="WindowsUpdate_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Диспетчер устройств" Click="DeviceManager_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Games: denser VPN-like layout -->
                    <Grid x:Name="PageGames" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PresetHint" FontSize="20" FontWeight="Bold" Text="Black Desert"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Text="Game Mode · план питания · приоритет процесса · точка восстановления"
                                               Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="999" Padding="12,7" VerticalAlignment="Center"
                                        Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1">
                                    <TextBlock Text="Boost ready" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <CheckBox x:Name="RestorePointCheck" Content="Точка восстановления перед бустом" IsChecked="True" Margin="0,0,0,14"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,12">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Применить" Margin="0,0,8,0" Click="ApplyBoost_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Приоритет" Margin="0,0,8,0" Click="FocusGame_Click"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Защита" Margin="0" Click="OpenRestore_Click"/>
                                        </UniformGrid>
                                        <Border Background="{StaticResource BrushBgDeep}" CornerRadius="12" Padding="12"
                                                BorderBrush="{StaticResource BrushLine}" BorderThickness="1" MinHeight="64">
                                            <TextBlock x:Name="GameLog" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" Text="Готово к бусту."/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Профиль"/>
                                        <ComboBox x:Name="GameProfileBox" Width="180" HorizontalAlignment="Left" Margin="0,0,0,16">
                                            <ComboBoxItem Content="FPS"/>
                                            <ComboBoxItem Content="Quality"/>
                                            <ComboBoxItem Content="Battery"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Процесс игры"/>
                                        <TextBox x:Name="GameProcessBox" Margin="0,0,0,6"/>
                                        <TextBlock Text="Без .exe — BlackDesert64, cs2, dota2…"
                                                   Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Быстрый выбор"/>
                                    <ListBox x:Name="PresetBox" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="PresetBox_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="#AA0C0F14"
                                                                    BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                                                    CornerRadius="12" Padding="14,12" Cursor="Hand">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}"/>
                                                                    <Setter TargetName="Bd" Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.35" Color="#FF3ECFAD"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentDim}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                                                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="{StaticResource BrushMuted}" FontSize="11"
                           Margin="2,10,0,0" Text="Готово"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
